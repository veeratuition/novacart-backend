SHIPROCKET_PASSWORD=YOUR_SHIPROCKET_PASSWORD

# Preferred: paste the COMPLETE Firebase service-account JSON as ONE line.
# Do NOT commit this value to GitHub.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"novacart-4dcd8","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-fbsvc@novacart-4dcd8.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

