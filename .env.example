NODE_ENV=production
PORT=5001

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_EXPIRES_IN=30d

# Firebase Admin - USE A CURRENT SERVICE ACCOUNT KEY
FIREBASE_PROJECT_ID=novacart-4dcd8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@novacart-4dcd8.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_NEW_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional legacy JSON form. Leave blank when the three variables above are set.
FIREBASE_SERVICE_ACCOUNT=

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Cashfree
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENVIRONMENT=production
